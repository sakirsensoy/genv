KEY_1=rubic
KEY_2="rubic"
KEY_3='rubic'

KEY_4= rubic
KEY_5=123
KEY_6=127.0.0.1

KEY_7=    127.0.0.1
KEY_8=1.23
KEY_9="1.23"

# This is a full line comment
KEY_10=value  # This is an inline comment
KEY_11=http://localhost:4443/storage/v1/  # API endpoint
KEY_12="value with # hash inside"
KEY_13='value with # hash inside'
KEY_14=value#nocomment
KEY_15=
KEY_16=  # only comment after empty value
KEY_17=true  # boolean with comment

# Export prefix support
export KEY_18=exported_value
export KEY_19="exported quoted"

# Escape sequences in double quotes (only \n and \r are expanded per motdotla/dotenv)
KEY_20="line1\nline2"
KEY_21="tab\there"
KEY_22="quote\"inside"
KEY_23="backslash\\"

# Single quotes are raw (no escape processing)
KEY_24='no\nescape'

# Backticks are raw
KEY_25=`backtick value`

# JSON inner quotes maintained
KEY_26={"foo":"bar"}
KEY_27={"foo": "bar", "baz": 123}

# Whitespace handling
KEY_28="  spaced  "
KEY_29='  spaced  '
KEY_30=  unquoted spaced  

# Empty quoted values
KEY_31=""
KEY_32=''

# Colon separator support (KEY: value)
KEY_33: colon_value
KEY_34: "colon quoted"